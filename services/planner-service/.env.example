# Copy to .env (git-ignored): cp .env.example .env. Read by config.py; an environment variable wins over .env.
# Every variable is required. The service does not start if one is missing.

# Base URL of registry-service (plots, soils, emitters).
REGISTRY_URL=http://127.0.0.1:8000
# Base URL of weather-service (the forecast).
WEATHER_URL=http://127.0.0.1:8001
# Seconds to wait for one registry-service call.
REGISTRY_TIMEOUT_SECONDS=3
# Seconds to wait for one weather-service call. Must be longer than weather-service's worst case
# (3 attempts x 3 s = about 9 s), or the planner gives up just before a stale forecast arrives.
WEATHER_TIMEOUT_SECONDS=12
