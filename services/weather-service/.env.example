# Copy to .env (git-ignored): cp .env.example .env. Read by config.py; an environment variable wins over .env.
# Every variable is required except PROVIDER_API_KEY. The service does not start if one is missing.

# Open-Meteo daily forecast endpoint.
PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
# Empty on Open-Meteo's free tier. A paid plan's key goes here, only in .env.
PROVIDER_API_KEY=
# Seconds to wait for one provider call.
PROVIDER_TIMEOUT_SECONDS=3
# Extra attempts after a failed call (FR-2.6: 2).
PROVIDER_RETRIES=2
# A cached forecast is fresh this long; no provider call meanwhile (FR-2.5: 3).
FORECAST_FRESH_HOURS=3
# When the provider fails, a cached forecast up to this old is served with "stale": true; older gives 503.
FORECAST_MAX_STALE_HOURS=24
