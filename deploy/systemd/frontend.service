# Installed to /etc/systemd/system/ by deploy/deploy.sh on every deploy. Edit here, not on the server.
# Serves the production build from `npm run build`; deploy.sh builds before it restarts this unit.
[Unit]
Description=AgroPilot frontend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ArgoPilot/services/frontend
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=on-failure

[Install]
WantedBy=multi-user.target
